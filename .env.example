# Veil CLI Wallet Configuration
# Copy this file to .env

# Your Ethereum wallet private key (for signing transactions, paying gas)
# DO NOT commit real keys to version control!
WALLET_KEY=0x...

# Alternative for unsigned/query flows when signing is handled externally
# Use SIGNER_ADDRESS for veil status, veil balance, and veil register --unsigned
# DO NOT set WALLET_KEY and SIGNER_ADDRESS at the same time
# SIGNER_ADDRESS=0xYourEthereumAddress

# Base RPC URL (optional, defaults to https://mainnet.base.org)
# For better reliability, use your own Alchemy/Infura/QuickNode endpoint
RPC_URL=https://mainnet.base.org

# Example with Alchemy:
# RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
